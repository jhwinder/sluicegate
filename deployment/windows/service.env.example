# Template for the sg-service environment file.
# The installer copies this to /opt/sluicegate/service.env inside WSL (root-only, mode 0600) and fills in the three
# values marked "set by the installer". It is created once and kept on upgrade; edit the copy inside WSL, not this file.
# Never put real secrets in this template.

# One-time administrator token for the first Admin Console sign-in (set by the installer: a new random value).
SG_BOOTSTRAP_ADMIN_KEY=REPLACE_WITH_ONE_TIME_BOOTSTRAP_SECRET

# Paths inside the container; the installer mounts the matching files there.
SG_DATABASE_PATH=/data/sg-service.sqlite3
SG_SIGNING_KEY_PATH=/run/secrets/sg-signing-key.pem
SG_POLICY_PATH=/config/production-policy.yml

# Set by the installer from -MinionId and -MissionControlUrl.
SG_PATCH_MINION_ID=PATCH-01
SG_PUBLIC_URL=https://sluicegate.example.internal

# Optional tuning (defaults shown).
SG_MINION_MAX_ATTEMPTS=3
SG_MINION_RETRY_INTERVAL_SECONDS=30
SG_MINION_ATTEMPT_TIMEOUT_SECONDS=300
SG_MINION_OVERALL_TIMEOUT_SECONDS=900
SG_MINION_HEARTBEAT_INTERVAL_SECONDS=30
SG_MINION_CLAIM_LEASE_SECONDS=120
SG_NOTIFY_MAX_ATTEMPTS=4

# Transport hardening (defaults shown; TLS 1.2 minimum is built in).
# SG_MAX_REQUEST_BYTES=5242880
# SG_KEEP_ALIVE_SECONDS=5
# SG_TLS_CIPHERS=ECDHE+AESGCM:ECDHE+CHACHA20

# Email credentials, if notifications are used, can be added here (the file is readable only by root inside WSL):
# RESEND_API_KEY=
# SG_SMTP_USERNAME=
# SG_SMTP_PASSWORD=
