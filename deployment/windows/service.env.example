# SluiceGate service-container environment template.
# Supply values through approved secret management; never commit a populated copy.
SG_BOOTSTRAP_ADMIN_KEY=REPLACE_WITH_ONE_TIME_BOOTSTRAP_SECRET
SG_DATABASE_PATH=/data/sg-service.sqlite3
SG_SIGNING_KEY_PATH=/run/secrets/sg-signing-key.pem
SG_PATCH_MINION_ID=PATCH-01
SG_POLICY_PATH=/config/production-policy.yml
