# SluiceGate service-container environment template.
# Supply values through approved secret management; never commit a populated copy.
SG_BOOTSTRAP_ADMIN_KEY=REPLACE_WITH_ONE_TIME_BOOTSTRAP_SECRET
SG_DATABASE_PATH=/data/sg-service.sqlite3
SG_SIGNING_KEY_PATH=/run/secrets/sg-signing-key.pem
SG_PATCH_MINION_ID=PATCH-01
SG_POLICY_PATH=/config/production-policy.yml
SG_MINION_MAX_ATTEMPTS=3
SG_MINION_RETRY_INTERVAL_SECONDS=30
SG_MINION_ATTEMPT_TIMEOUT_SECONDS=300
SG_MINION_OVERALL_TIMEOUT_SECONDS=900
SG_MINION_HEARTBEAT_INTERVAL_SECONDS=30
SG_MINION_CLAIM_LEASE_SECONDS=120
SG_PUBLIC_URL=https://sluicegate.example.gov
SG_NOTIFY_MAX_ATTEMPTS=4
# Email credentials are supplied as protected files, not values: RESEND_API_KEY_FILE, SG_SMTP_USERNAME_FILE, SG_SMTP_PASSWORD_FILE.
