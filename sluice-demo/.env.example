# Local development-only API credentials. Replace all values before starting Compose.
SG_BOOTSTRAP_ADMIN_KEY=replace-this-local-admin-key
SG_DEMO_AGENT_KEY=replace-this-local-agent-key
SG_DEMO_MINION_KEY=replace-this-local-minion-key

# Optional Resend API key, read by sg-service (never by the demo backend).
# Configure the adapter, profile, and verification in the sg-service Admin Console.
RESEND_API_KEY=
